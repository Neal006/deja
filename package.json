{
  "name": "dejactx",
  "version": "0.1.0",
  "description": "Déjà vu for your coding agent: cache-safe back-reference compression that stops AI agents from paying twice for context they have already seen.",
  "type": "module",
  "bin": {
    "deja": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "claude-code",
    "tokens",
    "context-window",
    "compression",
    "prompt-caching",
    "llm",
    "ai-agents",
    "vibecoding",
    "proxy",
    "dedup"
  ],
  "author": "Neal006",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neal006/deja.git"
  },
  "homepage": "https://github.com/Neal006/deja#readme",
  "bugs": {
    "url": "https://github.com/Neal006/deja/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
